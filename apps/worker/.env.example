# Supabase (service_role — worker 전용, 절대 웹에 노출 금지)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# web ↔ worker 공유 시크릿 (/enqueue 인증)
WORKER_SHARED_SECRET=

# 사이트 계정 암호화 키 (64 hex chars = 32 bytes) — web과 동일 값
CREDENTIALS_ENC_KEY=

# Anthropic (규격 파싱/결과표 추출)
ANTHROPIC_API_KEY=

# 기본 dry-run: true면 모든 제출 잡이 최종 제출 직전에 중단 (스테이징 기본값)
SUBMIT_DRY_RUN_DEFAULT=true

PORT=8080
