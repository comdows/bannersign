{
  "name": "youni",
  "private": true,
  "version": "0.1.0",
  "description": "지자체 현수막 게시대 자동 신청 SaaS 플랫폼",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm -r --workspace-concurrency=1 --if-present run build",
    "dev": "turbo run dev",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "corepack pnpm build && corepack pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "test": "corepack pnpm -r --workspace-concurrency=1 --if-present run test",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.0",
    "eslint": "^9.39.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0"
  }
}
